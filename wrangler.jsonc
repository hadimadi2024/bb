{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bb",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "58d6b855-bffd-4ebf-97cd-00fe00f66b5e","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bd1c3c93bcd84dfcb3fb2993b287c4ce" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
